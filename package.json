{
  "name": "barateza-ticket-notifier",
  "version": "3.5.2",
  "description": "Zendesk ticket monitor Chrome extension with code coverage",
  "main": "background.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:report": "node -e \"const fs=require('fs'); if(!fs.existsSync('coverage/coverage-summary.json')){throw new Error('coverage/coverage-summary.json not found. Run tests with coverage first.');} console.log('Coverage report is available at coverage/');\"",
    "test:e2e:setup": "node scripts/setup-e2e-auth.mjs",
    "test:e2e": "playwright test",
    "build": "./scripts/package.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "zendesk",
    "chrome-extension",
    "notifications",
    "ticket-monitoring"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@types/node": "^25.3.3",
    "babel-jest": "^30.4.1",
    "eslint": "^10.0.2",
    "eslint-plugin-jest": "^29.15.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  }
}
